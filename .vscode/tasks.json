{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Chạy toàn bộ dự án",
      "detail": "Ollama + Backend (kèm PostgreSQL) + Frontend, mỗi phần một terminal. Mở http://127.0.0.1:5173",
      "dependsOn": ["Ollama", "Backend", "Frontend"],
      "dependsOrder": "parallel",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Ollama",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/start-ollama.ps1",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": { "panel": "dedicated", "group": "cap1" },
      "problemMatcher": []
    },
    {
      "label": "Backend",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/start-backend.ps1",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": { "panel": "dedicated", "group": "cap1" },
      "problemMatcher": []
    },
    {
      "label": "Frontend",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/start-frontend.ps1",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": { "panel": "dedicated", "group": "cap1" },
      "problemMatcher": []
    },
    {
      "label": "Cài đặt lần đầu",
      "detail": "Chạy một lần sau khi lấy code: cài thư viện, bật PostgreSQL, tạo bảng, tải mô hình Ollama",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/setup.ps1",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
