openapi: 3.0.3
info:
  title: Widgets YAML
  version: "2"
paths:
  /widgets:
    get:
      operationId: listWidgets
      security:
        - apiKey: []
      responses:
        "200":
          description: ok
          content:
            application/json:
              schema:
                type: array
                items:
                  type: string
        "400":
          description: bad request
components:
  securitySchemes:
    apiKey:
      type: apiKey
      name: key
      in: header
