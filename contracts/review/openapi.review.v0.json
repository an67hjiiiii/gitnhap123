            "type": "string"
          },
          "source_ids": {
            "items": {
              "type": "string"
            },
            "title": "Source Ids",
            "type": "array"
          },
          "title": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "request_text"
        ],
        "title": "CaseInput",
        "type": "object"
      },
      "DecisionInput": {
        "additionalProperties": false,
        "properties": {
          "edited_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Edited Text"
          },
          "review": {
            "enum": [
              "ACCEPT",
              "REJECT",
              "EDIT"
            ],
            "title": "Review",
            "type": "string"
          }
        },
        "required": [
          "review"
        ],
        "title": "DecisionInput",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "RequirementInput": {
        "additionalProperties": false,
        "properties": {
          "confirmed": {
            "default": false,
            "title": "Confirmed",
            "type": "boolean"
          },
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "text": {
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "RequirementInput",
        "type": "object"
      },
      "RequirementsInput": {
        "additionalProperties": false,
        "properties": {
          "requirements": {
            "items": {
              "$ref": "#/components/schemas/RequirementInput"
            },
            "title": "Requirements",
            "type": "array"
          }
        },
        "required": [
          "requirements"
        ],
        "title": "RequirementsInput",
        "type": "object"
      },
      "RunInput": {
        "additionalProperties": false,
        "properties": {
          "budget": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Budget"
          }
        },
        "title": "RunInput",
        "type": "object"
      }
    }
  },
