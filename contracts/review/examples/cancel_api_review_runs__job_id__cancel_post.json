{
  "request": {
    "method": "POST",
    "path": "/api/review/runs/{job_id}:cancel",
    "headers": {
      "Authorization": "Bearer <access_token>"
    },
    "body": null
  },
  "response": {
    "status": 200,
    "body": {
      "id": "<job_id>",
      "case_id": "<case_id>",
      "state": "SUCCEEDED",
      "seq": 6,
      "budget": {
        "max_requirements": 100,
        "max_seconds": 3600
      },
      "started_at": "<timestamp>",
      "finished_at": "<timestamp>"
    }
  }
}
