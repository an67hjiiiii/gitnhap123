# Chép thành docker/.env rồi sửa. Không đưa tệp .env lên Git hay gửi cho người khác.

# Mật khẩu CSDL: chỉ dùng chữ và số (được ghép vào chuỗi kết nối), từ 16 ký tự trở lên.
POSTGRES_PASSWORD=

# Cổng mở giao diện trên máy chủ.
WEB_PORT=8080

# Ollama cài sẵn trên máy chủ (mặc định). Trên Linux, Ollama phải nghe ở mọi địa chỉ: đặt OLLAMA_HOST=0.0.0.0 cho dịch vụ ollama.
# Nếu chạy Ollama trong Docker (--profile ollama) thì đổi thành: http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# true khi người dùng truy cập qua HTTPS (đặt sau reverse proxy có chứng chỉ); false khi dùng http trong mạng nội bộ.
COOKIE_SECURE=false

# Mô hình trả lời (mặc định qwen3:4b, cần khoảng 4 GB RAM/VRAM trống). Bộ cài docker/install.ps1 gợi ý theo phần cứng.
LOCAL_LLM_MODEL=qwen3:4b
